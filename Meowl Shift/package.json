{
  "name": "meowl-shift",
  "version": "1.0.0",
  "description": "Meowl Shift - Roblox account manager: manage, validate and refresh cookies through a proxy with isolated sessions",
  "main": "main.js",
  "author": "Meowl Shift contributors",
  "license": "MIT",
  "scripts": {
    "start": "set \"ELECTRON_RUN_AS_NODE=\" && electron .",
    "dist": "electron-builder --win portable",
    "build": "electron-builder --win portable"
  },
  "dependencies": {
    "https-proxy-agent": "^7.0.6"
  },
  "devDependencies": {
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.meowlshift.app",
    "productName": "Meowl Shift",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "renderer/**/*", "node_modules/**/*"],
    "win": { "target": "portable", "icon": "build/icon.png" },
    "portable": { "artifactName": "MeowlShift.exe" }
  }
}
